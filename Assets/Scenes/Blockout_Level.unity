--- !u!114 &405411482
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 405411480}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b14d6cca267833f4eafeb3e24c6ce15a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HouseCreators.Blockout.BlockoutLabel
  text: "\u041B\u0415\u0413\u0415\u041D\u0414\u0410 \u041C\u0410\u041A\u0415\u0422\u0410\n\u0441\u0435\u0440\u044B\u0439
    \u2014 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F\n\u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439
    \u2014 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    (E)\n\u0436\u0451\u043B\u0442\u044B\u0439 \u2014 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\n\u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u2014 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\n\u0441\u0438\u043D\u0438\u0439
    \u2014 \u043B\u0430\u0437\u0430\u043D\u0438\u0435\n\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
    \u2014 \u0431\u0430\u0442\u0443\u0442\n\u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0439
    \u2014 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F\n\u0437\u0435\u043B\u0451\u043D\u044B\u0439
    \u2014 \u0447\u0435\u043A\u043F\u043E\u0438\u043D\u0442/\u0446\u0435\u043B\u044C\n\u0433\u043E\u043B\u0443\u0431\u043E\u0439
    \u0431\u0435\u0437 \u043A\u043E\u043B\u043B\u0430\u0439\u0434\u0435\u0440\u0430
    \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043F\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044E\n\n\u041A\u0432\u0435\u0441\u0442:
    \u0411\u043B\u043E\u043A\u043D\u043E\u0442 \u2192 \u0411\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0430
    (\u0441\u043F\u0430\u043B\u044C\u043D\u044F) \u2192 \u041B\u0438\u0444\u0442
    (\u043A\u0443\u0445\u043D\u044F)\n\u2192 \u041E\u0442\u0432\u0451\u0440\u0442\u043A\u0430
    \u2192 \u0420\u0430\u0434\u0438\u043E (\u0441\u043F\u0430\u043B\u044C\u043D\u044F)
    \u2192 \u041C\u0438\u043A\u0440\u043E\u0441\u0445\u0435\u043C\u0430 \u2192 \u041F\u0443\u043B\u044C\u0442"
  color: {r: 1, g: 1, b: 1, a: 1}
